# BLESS Travel Tours - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Environment
# ===========================================
# Set to "development" (or "dev"/"local") to enable simulated OTP and Turnstile test keys.
# Unset or any other value = production (simulated OTP disabled, test keys rejected).
ENVIRONMENT=development

# ===========================================
# Firebase Admin (backend only)
# ===========================================
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Firebase Web SDK (public, used in browser)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# ===========================================
# Admin Access
# ===========================================
# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=admin@example.com

# ===========================================
# Cloudflare Turnstile
# ===========================================
# Get keys at https://dash.cloudflare.com/ -> Turnstile
# Public site key (safe to expose in browser)
TURNSTILE_SITE_KEY=
# Secret key (backend only, never in browser)
TURNSTILE_SECRET_KEY=

# DEV ONLY: Cloudflare dummy test keys (always pass verification)
# Both must be set together or neither. NEVER use in production.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ===========================================
# Cloudinary (backend only)
# ===========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================
# Telegram Alerts (backend only)
# ===========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===========================================
# Email Delivery (OTP & approval emails)
# ===========================================
# Mode: "gmail", "resend", or "simulated" (fixed test code 123456, no email sent)
OTP_DELIVERY=simulated

# Gmail SMTP (app password, not login password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Resend API (domain must be verified for production)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Approval email channel (falls back to OTP_DELIVERY if not set)
APPROVAL_EMAIL_MODE=

# ===========================================
# Public Base URL (for canonical links, sitemap, Telegram alert links)
# ===========================================
PUBLIC_BASE_URL=

# ADMIN_BASE_URL is set automatically by dev.py via ngrok
# Set manually for production: ADMIN_BASE_URL=https://yourdomain.com